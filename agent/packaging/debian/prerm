#!/bin/sh
#
# UbuntuGuard agent -- pre-removal.
#
# Stops and disables both units before the files they execute are taken away.
# Doing it here rather than in postrm means the services are never running
# against a half-deleted virtualenv.
#
# On `upgrade` the services are deliberately left alone: dpkg unpacks the new
# version and runs postinst, and stopping a working agent for the duration of
# an upgrade would create a reporting gap for no benefit. The agent's code
# lives in a virtualenv that install.sh rebuilds in place, and systemd picks
# up the new code on the next restart.

set -e

SERVICE_NAME="ubuntuguard-agent"
ENFORCER_NAME="ubuntuguard-enforcerd"
AGENT_BIN="/opt/ubuntuguard/venv/bin/ubuntuguard-agent"
STATE_DIR="/var/lib/ubuntuguard"

USBGUARD_RULES="/etc/usbguard/rules.conf"
# The two markers the enforcer and the postinst write into rules.conf. Used to
# recognise a file this package is responsible for, and nothing else.
OURS_GENERATED="USBGuard policy -- GENERATED by ubuntuguard enforcerd"
OURS_BASELINE="Installed by ubuntuguard-agent as a starting point"

# Tell the server the agent is being removed, while it still can.
#
# Best effort by design, and it is the WEAKER half of detecting this. Anyone
# who stops the service first, pulls the network, or removes the identity by
# hand will not send it - and the docs are explicit that a local root user can
# do exactly that. The reliable signal is the absence of heartbeats, which the
# server already turns into an offline alert. This exists so the ordinary case,
# an administrator or employee running `apt remove`, is reported as what it is
# rather than looking identical to a laptop that was switched off.
#
# Never allowed to fail or hang the uninstall: a package that refuses to come
# off because a server is unreachable is a worse problem than a stale record.
notify_server() {
    [ -x "${AGENT_BIN}" ] || return 0
    [ -s "${STATE_DIR}/pki/device.key" ] || return 0
    echo "ubuntuguard-agent: telling the server this agent is being removed"
    timeout 15 "${AGENT_BIN}" deregister --reason "package removed" >/dev/null 2>&1 \
        || echo "ubuntuguard-agent: could not reach the server; the fleet record will" \
                "show this device as offline instead"
}

# Put USB back the way it was found.
#
# Without this, removing the package left the machine blocking USB storage with
# nothing installed to explain or undo it: the rules live in usbguard's own
# config, usbguard is a separate package and keeps running, and `purge` deletes
# the snapshot directory that held the previous ruleset. The employee ends up
# with a laptop that rejects USB drives, no UbuntuGuard, and no way to find out
# why short of editing root-owned files.
#
# An administrator's own ruleset is never touched. Only a file carrying one of
# this package's markers is replaced, because a hand-written policy is somebody
# else's decision and uninstalling us is not permission to undo it.
unlock_usb() {
    command -v usbguard >/dev/null 2>&1 || return 0
    [ -f "${USBGUARD_RULES}" ] || return 0

    if ! grep -qF "${OURS_GENERATED}" "${USBGUARD_RULES}" 2>/dev/null \
       && ! grep -qF "${OURS_BASELINE}" "${USBGUARD_RULES}" 2>/dev/null; then
        echo "ubuntuguard-agent: ${USBGUARD_RULES} was not written by this package;" \
             "leaving it alone"
        return 0
    fi

    echo "ubuntuguard-agent: restoring USB access before removal"
    # Written to a temporary file and moved into place, so usbguard never reads
    # a half-written ruleset. 0600 root because usbguard refuses a
    # world-readable one.
    cat > "${USBGUARD_RULES}.ubuntuguard-rollback" <<'RULES'
# Restored by ubuntuguard-agent when the package was removed.
#
# This allows every USB device, which is what the machine looked like before
# UbuntuGuard was installed. It is NOT a policy: it is the absence of one.
#
# usbguard blocks everything when its ruleset is empty, so this file has to
# exist. Deleting it would re-block every USB device on the machine, including
# the keyboard and mouse.
allow
RULES
    chmod 0600 "${USBGUARD_RULES}.ubuntuguard-rollback"
    chown root:root "${USBGUARD_RULES}.ubuntuguard-rollback"
    mv -f "${USBGUARD_RULES}.ubuntuguard-rollback" "${USBGUARD_RULES}"

    # usbguard has the old ruleset loaded; the file alone changes nothing until
    # it re-reads. Reloaded rather than restarted where possible, because a
    # restart briefly runs with an empty ruleset.
    if command -v systemctl >/dev/null 2>&1; then
        systemctl reload usbguard.service >/dev/null 2>&1 \
            || systemctl restart usbguard.service >/dev/null 2>&1 \
            || true
    fi
}

case "$1" in
    remove|deconfigure)
        # Order matters. Both of these need something that is about to go away:
        # the notification needs the agent binary and its identity, and the
        # rollback is clearer while the enforcer is still around to not fight
        # us over the file. Services are stopped afterwards.
        notify_server
        unlock_usb

        if command -v systemctl >/dev/null 2>&1; then
            # The enforcer first. It is the agent's dependency, not the other
            # way round, and stopping the privileged half before the half that
            # talks to it avoids a window where the agent retries a socket
            # that is going away.
            systemctl stop "${ENFORCER_NAME}.service" >/dev/null 2>&1 || true
            systemctl stop "${SERVICE_NAME}.service" >/dev/null 2>&1 || true
            systemctl disable "${ENFORCER_NAME}.service" >/dev/null 2>&1 || true
            systemctl disable "${SERVICE_NAME}.service" >/dev/null 2>&1 || true
        fi
        ;;
    upgrade|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac


exit 0
