#!/bin/sh
#
# UbuntuGuard agent -- post-installation configuration.
#
# This script deliberately does NOT enrol the device, and does NOT start the
# services. Both omissions are load-bearing.
#
# Not enrolling is feature D11's own constraint. Enrollment consumes a
# single-use token and creates an auditable device identity, so it needs a
# person behind it. A `.deb` cannot have one: it is unpacked by GNOME Software
# or by configuration management, neither of which can be handed a token, and
# the only way to make enrollment automatic would be to put a shared
# credential inside the package where every employee who downloads it can read
# it. Instead the package ships a desktop application --
# `ubuntuguard-enroll` -- which the employee opens once and pastes their own
# token into. That keeps "no terminal" without turning the token into public
# material.
#
# Not starting matches `install.sh`, which enables but does not start, because
# a freshly installed agent has no device identity and would do nothing but
# produce a warning loop in the journal. The enrollment application starts
# both units once the identity exists.
#
# The heavy lifting is delegated to packaging/install.sh rather than
# reimplemented here, so there is exactly one description of what an installed
# agent looks like and the 45 packaging tests that cover it still apply.

set -e

SHARE_DIR="/usr/share/ubuntuguard"
SOURCE_DIR="${SHARE_DIR}/agent-src"
WHEEL_DIR="${SHARE_DIR}/wheels"
CONFIG_DIR="/etc/ubuntuguard"
STATE_DIR="/var/lib/ubuntuguard"
SUPPORTED_OS_ID="ubuntu"

#: The login reminder. Copied into place here rather than shipped by dpkg,
#: because its presence IS the "this laptop still needs enrolling" state and
#: the privileged enrollment helper deletes it the moment an identity exists.
#: A dpkg-owned file could not work that way: dpkg would restore it on every
#: upgrade and an enrolled laptop would start being nagged again.
AUTOSTART_SOURCE="${SHARE_DIR}/ubuntuguard-enroll-autostart.desktop"
AUTOSTART_ENTRY="/etc/xdg/autostart/ubuntuguard-enroll.desktop"

case "$1" in
    configure)
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        exit 0
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# --- preflight ------------------------------------------------------------- #
# Checked here, before anything is modified, rather than left to install.sh.
# install.sh would refuse too, but it refuses partway through its own run; a
# failure in postinst leaves dpkg with a half-configured package, so the
# cheaper and clearer outcome is to decide before touching the system.
#
# Reported as a warning and not a refusal, because `Architecture:` and the
# dependency solver have already done the real gatekeeping, and a hard failure
# here on a derivative distribution that is Ubuntu in all but os-release ID
# would be unhelpful.

host_os_id=""
for candidate in /etc/os-release /usr/lib/os-release; do
    if [ -r "${candidate}" ]; then
        host_os_id="$(sed -n 's/^ID=//p' "${candidate}" | head -1 | tr -d '"')"
        [ -n "${host_os_id}" ] && break
    fi
done

if [ -n "${host_os_id}" ] && [ "${host_os_id}" != "${SUPPORTED_OS_ID}" ]; then
    echo "ubuntuguard-agent: WARNING: this host reports os-release ID" >&2
    echo "  '${host_os_id}'. The agent reads Ubuntu's interfaces and has one OS" >&2
    echo "  adapter. It may run, but nothing about it has been validated here." >&2
fi

if [ ! -f "${SOURCE_DIR}/pyproject.toml" ]; then
    echo "ubuntuguard-agent: ERROR: the agent source is missing from" >&2
    echo "  ${SOURCE_DIR}. The package is incomplete; reinstall it." >&2
    exit 1
fi

# --- install --------------------------------------------------------------- #
# PIP_NO_INDEX and PIP_FIND_LINKS point pip at the wheels carried inside this
# package instead of PyPI. Exported into the environment rather than passed as
# flags because install.sh builds its own pip command lines, and pip reads
# both variables natively -- so the install is fully offline without this
# package needing its own fork of install.sh.
#
# Offline matters for more than convenience: an employee installing from
# GNOME Software has no way to see a pip failure, and "the download worked but
# configuring it silently needed the internet" is the exact failure mode that
# makes a double-click installer untrustworthy.
#
# The wheelhouse carries pip itself for the same reason: install.sh runs
# `pip install --upgrade pip`, which with no index and no local pip wheel
# would fail and abort the install under `set -e`.
if [ -d "${WHEEL_DIR}" ]; then
    PIP_NO_INDEX=1
    PIP_FIND_LINKS="${WHEEL_DIR}"
    export PIP_NO_INDEX PIP_FIND_LINKS
    echo "ubuntuguard-agent: installing from the bundled wheels (no network needed)"
else
    echo "ubuntuguard-agent: no bundled wheels in ${WHEEL_DIR}; pip will use its" >&2
    echo "  configured index, which needs network access." >&2
fi

# --no-instructions: install.sh's closing text tells an operator to edit
# agent.yaml and enrol by hand with a shell command. This package has already
# written agent.yaml, and its answer to enrollment is the desktop application,
# so that text would send the employee somewhere wrong.
#
# install.sh enables both units and does not start them, which is what this
# package wants, so --no-enable is deliberately NOT passed.
# Invoked with bash explicitly, not `sh`. install.sh has a bash shebang and
# uses `[[`, `local` and ${BASH_SOURCE}; on Ubuntu /bin/sh is dash, which fails
# on the first conditional with "[[: not found" and then dies claiming
# pyproject.toml is missing -- a confusing error that has nothing to do with
# the real cause. bash is Essential, so it needs no dependency declaration.
bash "${SOURCE_DIR}/packaging/install.sh" \
    --source "${SOURCE_DIR}" \
    --no-instructions

# --- configuration --------------------------------------------------------- #
# agent.yaml is shipped as a dpkg conffile, so it is already unpacked by the
# time this runs and install.sh will have kept it rather than overwriting it
# with the example. Nothing to write here; the check exists so that a missing
# config is reported now rather than as a confusing agent startup failure
# later.
if [ ! -f "${CONFIG_DIR}/agent.yaml" ]; then
    echo "ubuntuguard-agent: WARNING: ${CONFIG_DIR}/agent.yaml is missing, which" >&2
    echo "  should not be possible for a conffile. The agent will not start until" >&2
    echo "  it has a server URL." >&2
fi

# Refresh the desktop and polkit caches so the enrollment application appears
# in the applications menu without a logout. Both are best-effort: the
# application is still launchable without them.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
fi

# --- do not lock the employee out of their own USB devices ----------------- #
# This package Depends on usbguard, so apt installs and STARTS usbguard before
# this script runs. usbguard's own defaults, read from the package rather than
# assumed:
#
#   ImplicitPolicyTarget=block      anything not matching a rule is blocked
#   PresentDevicePolicy=apply-policy  already-connected devices are included
#   RuleFile=/etc/usbguard/rules.conf
#
# and the package ships no rules.conf at all, only an empty rules.d directory.
# An empty ruleset plus an implicit block plus apply-policy means every USB
# device attached to the laptop is deauthorized the moment usbguard starts: an
# external keyboard and mouse, a USB webcam, an internal bluetooth or
# fingerprint reader on a USB bus. PresentControllerPolicy=keep spares the
# controllers, not the devices.
#
# That would be this package breaking the machine it was installed to protect,
# before it has been enrolled or given any policy at all.
#
# So a baseline is seeded: allow what is plugged in right now. This is
# usbguard's own documented bootstrap, and it is written only when there is no
# ruleset to overwrite -- an administrator's existing rules.conf is left
# exactly alone.
#
# It does not weaken anything. Until an administrator sets a policy there is
# nothing to enforce, and the agent's whole model is default-allow outside the
# protected device classes. When a policy does arrive the enforcer replaces
# this file with the derived ruleset.
#
# usbguard-daemon.conf is deliberately NOT touched. It is a conffile owned by
# the usbguard package; editing another package's conffile would provoke dpkg
# prompts on their upgrades and silently change a security setting an
# administrator may have chosen. rules.conf is shipped by nobody, so creating
# it is ours to do.
USBGUARD_RULES="/etc/usbguard/rules.conf"

seed_usbguard_baseline() {
    command -v usbguard >/dev/null 2>&1 || return 0

    # Present and non-empty means somebody -- an administrator, or a previous
    # install of this package -- already decided. Leave it.
    if [ -s "${USBGUARD_RULES}" ]; then
        echo "ubuntuguard-agent: keeping the existing ${USBGUARD_RULES}"
        return 0
    fi

    generated="$(usbguard generate-policy 2>/dev/null || true)"
    if [ -z "${generated}" ]; then
        # No devices enumerated, or usbguard cannot read sysfs. Writing an
        # empty file here would be the lockout this function exists to
        # prevent, so nothing is written and the operator is told.
        echo "ubuntuguard-agent: WARNING: could not generate a usbguard baseline." >&2
        echo "  usbguard blocks every device when its ruleset is empty. Before" >&2
        echo "  starting it, run: usbguard generate-policy > ${USBGUARD_RULES}" >&2
        return 0
    fi

    echo "ubuntuguard-agent: seeding ${USBGUARD_RULES} with the devices present now"
    install -d -m 0755 -o root -g root /etc/usbguard
    # 0600 root: the ruleset names every device on the machine, and usbguard
    # refuses a world-readable one.
    printf '%s\n' "${generated}" > "${USBGUARD_RULES}.ubuntuguard-new"
    chmod 0600 "${USBGUARD_RULES}.ubuntuguard-new"
    chown root:root "${USBGUARD_RULES}.ubuntuguard-new"
    mv -f "${USBGUARD_RULES}.ubuntuguard-new" "${USBGUARD_RULES}"

    # Re-apply, because usbguard has already started against the empty
    # ruleset and will have deauthorized things. A restart re-reads the file
    # and re-authorizes everything the baseline allows.
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl is-active --quiet usbguard.service 2>/dev/null; then
            systemctl restart usbguard.service >/dev/null 2>&1 || true
        fi
    fi
}

seed_usbguard_baseline

# --- the enrollment prompt ------------------------------------------------- #
# Installing must not enrol, but it should not leave the employee hunting
# through a menu either. So the package arranges for the prompt to come to
# them, by two routes, neither of which enrols anything by itself.
#
# Both are skipped when this laptop already has an identity, which is the
# normal case on an upgrade: re-asking an enrolled laptop for a token would be
# a prompt whose only correct answer is to close it.
# "Usable", not merely "present". Both halves, both non-empty, and a
# certificate that parses and has not expired.
#
# File presence alone was the first version of this check and it stranded a
# real laptop: an orphaned key and certificate from an attempt the server never
# completed made this script report "already enrolled", skip the prompt and
# delete the login reminder, leaving the employee with nothing to act on.
#
# A plain `apt remove` deliberately KEEPS /var/lib/ubuntuguard so a reinstall
# needs no new token, so every reinstall-after-remove arrives with key material
# on disk. The weaker check would mis-handle all of them.
#
# When the answer cannot be established the prompt is shown. An unnecessary
# prompt is a dialog someone closes; a suppressed one is a laptop that never
# enrols and says nothing about why.
already_enrolled() {
    key="${STATE_DIR}/pki/device.key"
    crt="${STATE_DIR}/pki/device.crt"
    [ -s "${key}" ] && [ -s "${crt}" ] || return 1
    if command -v openssl >/dev/null 2>&1; then
        openssl x509 -in "${crt}" -noout -checkend 0 >/dev/null 2>&1 || return 1
    fi
    return 0
}

if already_enrolled; then
    echo "ubuntuguard-agent: this laptop is already enrolled; not prompting"
    rm -f "${AUTOSTART_ENTRY}"
else
    # Route one, and the reliable one: a login reminder. It explains itself and
    # offers "Later" before showing any entry field, and it keeps coming back
    # until somebody enrols, because the enrollment helper is what removes it.
    if [ -f "${AUTOSTART_SOURCE}" ]; then
        install -d -m 0755 /etc/xdg/autostart
        install -m 0644 -o root -g root "${AUTOSTART_SOURCE}" "${AUTOSTART_ENTRY}"
    fi

    # Route two, best effort: show it now, so that installing and enrolling
    # feel like one action rather than two.
    #
    # Best effort really does mean that. postinst runs as root with no session
    # of its own -- under GNOME Software it runs inside packagekitd -- so
    # reaching the employee's display means finding their session and
    # borrowing its bus. If any step fails, the reminder above still fires at
    # the next login and the applications menu entry is always there. Nothing
    # is reported as an error, because nothing has gone wrong.
    #
    # `loginctl` is asked which session is actually active rather than
    # guessing DISPLAY=:0, which is wrong on Wayland, wrong with more than one
    # seat, and wrong when the installing user is not the logged-in one.
    if command -v loginctl >/dev/null 2>&1 && command -v systemd-run >/dev/null 2>&1; then
        session="$(loginctl list-sessions --no-legend 2>/dev/null \
            | awk '{print $1}' \
            | while read -r candidate; do
                  [ -n "${candidate}" ] || continue
                  if [ "$(loginctl show-session "${candidate}" -p Active --value 2>/dev/null)" = "yes" ] \
                  && [ "$(loginctl show-session "${candidate}" -p Type --value 2>/dev/null)" != "tty" ]; then
                      printf '%s' "${candidate}"
                      break
                  fi
              done)"

        if [ -n "${session:-}" ]; then
            session_uid="$(loginctl show-session "${session}" -p User --value 2>/dev/null || true)"
            if [ -n "${session_uid}" ] && [ -S "/run/user/${session_uid}/bus" ]; then
                # Detached into the user's own systemd instance so it does not
                # become a child of dpkg. A GUI left as dpkg's child would keep
                # apt waiting on a dialog nobody has answered yet, and GNOME
                # Software would sit at 99% until they did.
                systemd-run \
                    --quiet \
                    --collect \
                    --uid="${session_uid}" \
                    --setenv=DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${session_uid}/bus" \
                    --setenv=XDG_RUNTIME_DIR="/run/user/${session_uid}" \
                    /usr/bin/ubuntuguard-enroll --autostart \
                    >/dev/null 2>&1 || true
            fi
        fi
    fi
fi

cat <<'EOF'

UbuntuGuard agent installed. This laptop is NOT yet enrolled.

  A window should appear asking for your one-time enrollment token. If
  it does not, open "Enrol this laptop with UbuntuGuard" from your
  applications menu and paste the token your administrator sent you.

  Nothing is reported and no policy applies until that is done.

EOF


exit 0
