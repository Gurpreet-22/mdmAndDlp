# ---------------------------------------------------------------------------
# UbuntuGuard .gitignore
# Rule 1: no secrets, keys, certificates or device state ever enter this repo.
# ---------------------------------------------------------------------------

# --- Keys, certificates, secrets (deny broadly, allow nothing by default) ---
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.der
*.gpg
*.asc
*.kdbx
id_ed25519*
id_rsa*
.env
.env.*
!.env.example
secrets/
.secrets/
private/
ca/
pki/

# Policy signing material (Ed25519) and internal CA material must stay local.
*policy-signing*
*signing-key*
*_private*
*.priv

# --- Local dev state ---
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
pgdata/
*.log
logs/

# --- Python (server) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv-tools/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# --- Go (agent) ---
/agent/bin/
/agent/dist/
*.test
*.out

# --- Node (dashboard) ---
node_modules/
dashboard/dist/
dashboard/.vite/
*.tsbuildinfo

# --- Debian packaging output ---
*.deb
*.buildinfo
*.changes
debian/.debhelper/
debian/files
debian/ubuntuguard-agent/
debian/tmp/

# --- Editors / OS ---
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# --- Local toolchain pinned by the Makefile ---
/.tool/

# --- USBGuard spike output ---
# Machine-specific, and may contain USB serial numbers from a test host.
# The filled-in RESULTS.md is meant to be committed; raw captures are not.
spike/usbguard/evidence/
spike/usbguard/backup/

# --- Local key material generated by `ubuntuguard init-keys` ---
server/var/
var/
